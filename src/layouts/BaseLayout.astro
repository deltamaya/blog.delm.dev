---
import "../styles/global.css";
import { getAllYears } from "../lib/blogs";

interface Props { title?: string }
const title = Astro.props.title ? `${Astro.props.title} — DELM Blog` : "DELM Blog";
const archiveYear = getAllYears()[0] ?? new Date().getFullYear();
const navigation = [
  { href: "/", label: "Home" },
  { href: `/archive/${archiveYear}`, label: "Archive" },
  { href: "/topics", label: "Topics" },
  { href: "/search", label: "Search" },
];
const section = Astro.url.pathname.split("/")[1];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="DELM Blog RSS Feed" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.toggle("dark", localStorage.getItem("theme") === "dark");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="shell masthead-inner">
        <a class="wordmark" href="/" aria-label="DELM Blog home">
          <img class="dark:hidden" src="/logo.svg" alt="" width="40" height="22" />
          <img class="hidden dark:block" src="/logo-white.svg" alt="" width="40" height="22" />
          <span>DELM<span class="wordmark-blog"> Blog</span></span>
        </a>
        <nav aria-label="Main navigation">
          {navigation.map(({ href, label }) => (
            <a href={href} aria-current={section === href.split("/")[1] ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <button id="theme-toggle" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode">
          <span class="theme-icon" aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="shell site-footer">
      <span>© {new Date().getFullYear()} <a href="https://delm.dev">deltamaya</a></span>
      <span>All works licensed under <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a></span>
      <a href="/rss.xml">RSS feed</a>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle")!;
      toggle.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
      toggle.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", dark ? "dark" : "light");
        toggle.setAttribute("aria-pressed", String(dark));
      });
    </script>
  </body>
</html>
