---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import TopicList from "../../components/TopicList.astro";
import { getAllTags, getTaggedBlogsMeta, getTagCounts } from "../../lib/blogs";

export function getStaticPaths() {
  return getAllTags().map(tag => ({ params: { tag } }));
}
const { tag } = Astro.params;
const posts = getTaggedBlogsMeta(tag!);
---
<BaseLayout title={`#${tag}`}>
  <div class="shell collection">
    <header class="collection-header"><h1><em>#</em>{tag}</h1><a class="text-link" href="/topics">All topics</a></header>
    <div class="home-columns">
      <section><div class="section-bar"><h2>Articles</h2><span class="metadata">{posts.length}</span></div>
        {posts.map(post => <PostRow post={post} />)}
      </section>
      <aside><div class="section-bar"><h2>Other topics</h2></div><TopicList topics={getTagCounts().filter(([name]) => name !== tag).slice(0, 12)} /></aside>
    </div>
  </div>
</BaseLayout>
