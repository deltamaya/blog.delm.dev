---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicList from "../../components/TopicList.astro";
import { getAllBlogsMeta, getTagCounts } from "../../lib/blogs";

const topics = getTagCounts();
const total = getAllBlogsMeta().length;
---
<BaseLayout title="Topics">
  <div class="shell collection">
    <header class="collection-header"><h1>Topics</h1><p class="metadata">{topics.length} topics · {total} {total === 1 ? "article" : "articles"}</p></header>
    <TopicList topics={topics} />
  </div>
</BaseLayout>
