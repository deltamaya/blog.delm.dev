---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getBlogsByYear, getAllYears } from "../../lib/blogs";

export function getStaticPaths() {
  const years = new Set(getAllYears());
  for (let year = 2024; year <= new Date().getFullYear(); year++) years.add(year);
  return [...years].map(year => ({ params: { year: String(year) } }));
}
const year = Number(Astro.params.year);
const months = getBlogsByYear(year);
const years = getAllYears();
const firstYear = Math.min(2024, ...years);
const lastYear = Math.max(new Date().getFullYear(), ...years);
---
<BaseLayout title={`Archive ${year}`}>
  <div class="shell collection">
    <header class="collection-header"><h1>Archive</h1><span class="metadata">{year}</span></header>
    <div class="archive-columns">
      <nav aria-label="Archive years" class="year-nav">
        {Array.from({length: lastYear - firstYear + 1}, (_, i) => lastYear - i).map(y =>
          <a href={`/archive/${y}`} aria-current={y === year ? "page" : undefined}>{y}</a>
        )}
      </nav>
      <div>
        {[...months].map(([month, posts]) => (
          <section class="archive-month"><div class="section-bar"><h2>{month}</h2><span class="metadata">{posts.length} {posts.length === 1 ? "article" : "articles"}</span></div>
            {posts.map(post => <PostRow post={post} />)}
          </section>
        ))}
        {!months.size && <p class="empty">No posts in {year}.</p>}
      </div>
    </div>
  </div>
</BaseLayout>
