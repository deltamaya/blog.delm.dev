---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getAllBlogsMeta } from "../../lib/blogs";

const posts = getAllBlogsMeta();
---
<BaseLayout title="Search">
  <div class="shell collection">
    <header class="collection-header"><h1>Search</h1></header>
    <form id="search-form" class="search-form" role="search" action="https://www.google.com/search" target="_blank" rel="noopener">
      <label for="query">Search titles and tags</label>
      <div class="search-controls"><input id="query" type="search" placeholder="Title or topic…" autocomplete="off" /><input id="google-query" type="hidden" name="q" value="site:blog.delm.dev" /><button type="submit">Search on Google</button></div>
    </form>
    <p id="status" class="metadata" role="status">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
    <ul>{posts.map(post => <li data-title={post.title} data-tags={JSON.stringify(post.tags)}><PostRow post={post} /></li>)}</ul>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>("#query")!;
    const status = document.querySelector("#status")!;
    const googleQuery = document.querySelector<HTMLInputElement>("#google-query")!;
    const rows = [...document.querySelectorAll<HTMLElement>("li[data-title]")].map(row => ({
      row,
      title: row.dataset.title!,
      tags: JSON.parse(row.dataset.tags!) as string[],
      label: row.querySelector(".row-title")!,
    }));

    function filterPosts() {
      const query = input.value.trim().toLowerCase();
      googleQuery.value = `site:blog.delm.dev ${input.value.trim()}`.trim();
      let count = 0;
      for (const { row, title, tags, label } of rows) {
        const index = title.toLowerCase().indexOf(query);
        row.hidden = index < 0 && !tags.some(tag => tag.includes(query));
        if (row.hidden) continue;
        count++;
        label.textContent = title;
        if (query && index >= 0) {
          const match = document.createElement("mark");
          match.textContent = title.slice(index, index + query.length);
          label.replaceChildren(title.slice(0, index), match, title.slice(index + query.length));
        }
      }
      status.textContent = count ? `${count} ${count === 1 ? "article" : "articles"}` : "No results found";
    }
    input.addEventListener("input", filterPosts);
    filterPosts();
  </script>
</BaseLayout>
