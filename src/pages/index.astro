---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import TopicList from "../components/TopicList.astro";
import { getAllBlogsMeta, getTagCounts } from "../lib/blogs";

const posts = getAllBlogsMeta();
const [lead, ...recent] = posts.slice(0, 8);
const archiveYear = lead?.date.getFullYear() ?? new Date().getFullYear();
---

<BaseLayout>
  <div class="shell">
    <header class="home-intro">
      <h1>Technology,<br />systems <em>&amp; ideas.</em></h1>
      <div class="intro-note">
        <p>Personal notes and long-form articles by <a href="https://delm.dev">deltamaya</a>.</p>
        <small>Can make mistakes, for reference only.</small>
      </div>
    </header>
    <div class="home-columns">
      <section aria-labelledby="latest">
        <div class="section-bar"><h2 id="latest">Latest writing</h2><a href={`/archive/${archiveYear}`}>View archive</a></div>
        {lead ? (
          <article class="lead-post">
            {lead.cover && <a class="post-cover" href={`/blog/${lead.slug}`} aria-label={`Read ${lead.title}`}><img src={lead.cover} alt="" fetchpriority="high" /></a>}
            <div class="lead-meta metadata">
              <time datetime={lead.date.toISOString()}>{lead.date.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric" })}</time>
              {lead.authors.length > 0 && <span>By {lead.authors.join(", ")}</span>}
            </div>
            <h3><a href={`/blog/${lead.slug}`}>{lead.title}</a></h3>
            {lead.description && <p class="lead-summary">{lead.description}</p>}
            <div class="tags">{lead.tags.map(tag => <a href={`/topics/${tag}`}>#{tag}</a>)}</div>
          </article>
        ) : <p class="empty">No articles yet.</p>}
        {recent.map(post => <PostRow post={post} />)}
      </section>
      <aside>
        <div class="section-bar"><h2>Topics</h2><a href="/topics">View all</a></div>
        <TopicList topics={getTagCounts().slice(0, 16)} />
        <div class="aside-links"><a href="/rss.xml">RSS feed</a><a href="https://delm.dev">delm.dev</a></div>
      </aside>
    </div>
  </div>
</BaseLayout>
